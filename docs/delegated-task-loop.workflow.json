  "cards": [
    {
      "dot": "cyan",
      "title": "Where each hook sits",
      "items": [
        "\u00a73 names the proof artifact before the agent spawns",
        "\u00a74 reads direction once, while the run can still change",
        "\u00a75 commits the second correction where every session reads it"
      ]
    },
    {
      "dot": "amber",
      "title": "Unproven",
      "items": [
        "No team has spawned under the proof contract yet",
        "The direction signals are guesses until one hand-run pass",
        "Nothing tracks the first occurrence behind the twice-trigger"
      ]
    }
  ]
