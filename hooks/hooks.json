{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LORE_RERANK=0 ${CLAUDE_PLUGIN_ROOT}/lore.sh resume 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/cmux-sidebar.sh 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LORE_DATA_DIR=\"${LORE_DATA_DIR:-$HOME/.local/share/lore}\" ${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/pre-compact.sh 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
